# Git stores normalized text; checked-out code and prose use CRLF.
*.md text eol=crlf
*.h text eol=crlf
*.hpp text eol=crlf
*.cpp text eol=crlf
*.cc text eol=crlf
*.cxx text eol=crlf
*.cs text eol=crlf
LICENSE text eol=crlf

# Tool and script files need LF without a UTF-8 BOM.
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.clang-format text eol=lf
.csharpierrc text eol=lf
Doxyfile text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Preserve the upstream PuerTS source and license byte-for-byte.
NelaricGameplay/Plugins/Puerts/** -text -eol

# Store large PuerTS backend libraries in the configured Git LFS endpoint.
NelaricGameplay/Plugins/Puerts/ThirdParty/v8_9.4.146.24/Lib/Win64MD/wee8.lib filter=lfs diff=lfs merge=lfs -text
NelaricGameplay/Plugins/Puerts/ThirdParty/nodejs_16/lib/Win64/libnode.dll filter=lfs diff=lfs merge=lfs -text
NelaricGameplay/Plugins/Puerts/ThirdParty/nodejs_16/lib/Linux/libnode.so.93 filter=lfs diff=lfs merge=lfs -text
NelaricGameplay/Plugins/Puerts/ThirdParty/nodejs_16/lib/macOS/libnode.93.dylib filter=lfs diff=lfs merge=lfs -text
NelaricGameplay/Plugins/Puerts/ThirdParty/nodejs_16/lib/macOS_arm64/libnode.93.dylib filter=lfs diff=lfs merge=lfs -text
